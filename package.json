{
  "name": "waiwai-verse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube live linked, real-time 2D avatar space over WebTransport (Ameba Pigg style).",
  "workspaces": [
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "gen-cert": "npm run gen-cert -w server",
    "sync-config": "node scripts/sync-config.mjs",
    "server": "npm run start -w server",
    "client": "npm run dev -w client",
    "desktop": "npm run start -w desktop",
    "setup": "npm run gen-cert && npm run sync-config",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "license": "0BSD"
}
