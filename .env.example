# Copy to .env or just export these before `npm run server`.

# WebTransport server
PORT=4433
WT_PATH=/room
WT_SECRET=change-me-secret
TICK_HZ=20

# YouTube live chat (optional). Leave blank to disable.
# Get an API key from Google Cloud Console (YouTube Data API v3 enabled).
# YT_VIDEO_ID is the live stream video id (the v= part of the watch URL).
YT_API_KEY=
YT_VIDEO_ID=
